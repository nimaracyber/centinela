# Copiar a .env y completar. NUNCA subir .env a git.
# Si un valor tiene $, # o espacios, escribilo entre comillas simples:  CLAVE='ab$c#1'
# Generar las dos claves con:  docker compose run --rm --no-deps worker gen-key

CENTINELA_ENCRYPTION_KEY=
CENTINELA_DASHBOARD_SECRET_KEY=
# (el hash de la contraseña del panel va directo en config.yaml: dashboard.admin_password_hash)

# Solo letras y números (va dentro de la dirección de la base de datos). No cambiarla después de instalar.
POSTGRES_PASSWORD=

# Reputación por hash (opcional, gratis). Nunca se suben archivos: solo el SHA-256.
MALWAREBAZAAR_API_KEY=
VIRUSTOTAL_API_KEY=

# Conectores (según los que uses)
IMAP_OFICINA_PASSWORD=
GRAPH_CLIENT_SECRET=

# Alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_ALERT_PASSWORD=
SLACK_WEBHOOK_URL=
