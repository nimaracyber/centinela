# Copiar a .env y completar. NUNCA subir .env a git.
# Generar claves con:  docker compose run --rm api gen-key

CENTINELA_ENCRYPTION_KEY=
CENTINELA_DASHBOARD_SECRET_KEY=
# Hash argon2 de la contraseña del dashboard:  docker compose run --rm api hash-password
# (en .env, escapar cada $ como $$ porque docker compose interpreta $)
CENTINELA_DASHBOARD_PASSWORD_HASH=

POSTGRES_PASSWORD=

# Reputación por hash (opcional, gratis). Nunca se suben archivos: solo el SHA-256.
MALWAREBAZAAR_API_KEY=
VIRUSTOTAL_API_KEY=

# Conectores (según los que uses)
IMAP_OFICINA_PASSWORD=
GRAPH_CLIENT_SECRET=

# Alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_ALERT_PASSWORD=
SLACK_WEBHOOK_URL=
